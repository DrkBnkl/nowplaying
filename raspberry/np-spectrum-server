#!/usr/bin/python3
"""Spectrum service for the Now Playing display.

Receives the audio copy from np-spectrum-feed, computes 40 frequency
bands via FFT and distributes them as Server-Sent Events:

    GET /spectrum  ->  data: 0;120;530;...;0     (40 values, 0..1000, ~30 times per second)
    GET /status    ->  JSON with format and state
"""
import json
import os
import socket
import struct
import threading
import time
from collections import deque
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import numpy as np

SOCK = "/run/nowplaying-spectrum/audio.sock"
PORT = int(os.environ.get("PORT", "8090"))
BANDS = int(os.environ.get("BANDS", "40"))
FPS = float(os.environ.get("FPS", "30"))
DELAY = float(os.environ.get("DELAY_MS", "0")) / 1000.0  # hold bars back if they run ahead of the audio
FMIN = float(os.environ.get("FMIN", "40"))
FMAX = float(os.environ.get("FMAX", "16000"))
RANGE_DB = float(os.environ.get("RANGE_DB", "45"))
TILT_DB = float(os.environ.get("TILT_DB", "3"))  # boost per octave so the treble becomes visible

lock = threading.Lock()
stream = {"pid": None, "rate": 44100, "channels": 2, "bytes": 2, "bits": 16, "float": False, "last": 0.0}
ring = np.zeros(16384, dtype=np.float32)
ring_pos = 0
frames = deque()       # (output time, text)
levels = deque(maxlen=30)   # (sum of squares, sample count) per second of audio
level_acc = [0.0, 0]
current = {"text": ";".join(["0"] * BANDS), "seq": 0}
cond = threading.Condition()


def decode(data):
    nb, ch = stream["bytes"], stream["channels"]
    if nb == 2:
        x = np.frombuffer(data, dtype="<i2").astype(np.float32) / 32768.0
    elif nb == 4 and stream["float"]:
        x = np.frombuffer(data, dtype="<f4").astype(np.float32)
    elif nb == 4:
        # S24_LE is packed in 4 bytes (24 bits in the lower bytes), S32_LE uses all 32
        full = 8388608.0 if stream["bits"] == 24 else 2147483648.0
        x = np.frombuffer(data, dtype="<i4").astype(np.float32) / full
    elif nb == 3:
        b = np.frombuffer(data, dtype=np.uint8).reshape(-1, 3).astype(np.int32)
        v = b[:, 0] | (b[:, 1] << 8) | (b[:, 2] << 16)
        v = np.where(v & 0x800000, v - 0x1000000, v)
        x = v.astype(np.float32) / 8388608.0
    else:
        return None
    if ch > 1:
        x = x[: len(x) - len(x) % ch].reshape(-1, ch).mean(axis=1)
    return x


def receiver():
    global ring_pos
    os.makedirs(os.path.dirname(SOCK), exist_ok=True)
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 1 << 20)
    s.bind(SOCK)
    os.chmod(SOCK, 0o666)  # Caldera runs as its own user
    while True:
        pkt = s.recv(1 << 17)
        if len(pkt) < 5:
            continue
        pid, kind = struct.unpack("<IB", pkt[:5])
        with lock:
            if kind == 0 and len(pkt) >= 17:
                rate, ch, bits, tag, block = struct.unpack("<IHHHH", pkt[5:17])
                if pid != stream["pid"]:   # new stream (different source): restart level measurement
                    levels.clear()
                    level_acc[0], level_acc[1] = 0.0, 0
                stream.update(pid=pid, rate=rate, channels=max(1, ch), bits=bits,
                              bytes=max(1, block // max(1, ch)), float=(tag == 3), last=time.time())
                continue
            if kind != 1 or pid != stream["pid"]:
                continue
            try:
                x = decode(pkt[5:])
            except ValueError:  # packet length does not match the format: drop, don't abort
                continue
            if x is None or not len(x):
                continue
            n = len(x)
            if n >= len(ring):
                ring[:] = x[-len(ring):]
                ring_pos = 0
            else:
                end = ring_pos + n
                if end <= len(ring):
                    ring[ring_pos:end] = x
                else:
                    k = len(ring) - ring_pos
                    ring[ring_pos:] = x[:k]
                    ring[: n - k] = x[k:]
                ring_pos = end % len(ring)
            stream["last"] = time.time()
            # Level: accumulate sum of squares per second, /status averages the last 30 s
            level_acc[0] += float(np.dot(x, x))
            level_acc[1] += n
            if level_acc[1] >= stream["rate"]:
                levels.append((level_acc[0], level_acc[1]))
                level_acc[0], level_acc[1] = 0.0, 0


def analyzer():
    ref = -20.0
    cache = {}
    period = 1.0 / FPS
    sent = 0.0
    while True:
        t0 = time.time()
        with lock:
            rate, last = stream["rate"], stream["last"]
            win = 2048 if rate <= 48000 else (4096 if rate <= 96000 else 8192)
            idx = (np.arange(ring_pos - win, ring_pos)) % len(ring)
            x = ring[idx].copy()
        if t0 - last > 0.5:
            text = ";".join(["0"] * BANDS)
        else:
            key = (rate, win)
            if key not in cache:
                freqs = np.fft.rfftfreq(win, 1.0 / rate)
                edges = np.geomspace(FMIN, min(FMAX, rate / 2 * 0.95), BANDS + 1)
                lo = np.searchsorted(freqs, edges[:-1])
                hi = np.maximum(np.searchsorted(freqs, edges[1:]), lo + 1)
                centers = np.sqrt(edges[:-1] * edges[1:])
                tilt = TILT_DB * np.log2(centers / 1000.0)
                # In the bass the bands are narrower than the FFT bin spacing: interpolate between
                # bins there, otherwise several bars show the same value
                narrow = (edges[1:] - edges[:-1]) < freqs[1]
                cache[key] = (np.hanning(win).astype(np.float32), lo, hi, tilt, freqs, centers, narrow)
            w, lo, hi, tilt, freqs, centers, narrow = cache[key]
            mag = np.abs(np.fft.rfft(x * w)) / (win / 4)
            band = np.array([mag[a:b].max() for a, b in zip(lo, hi)])
            band = np.where(narrow, np.interp(centers, freqs, mag), band)
            db = 20 * np.log10(band + 1e-9) + tilt
            peak = float(db.max())
            ref = peak if peak > ref else max(ref - 0.5 * period, peak, -60.0)  # auto gain
            lvl = np.clip((db - (ref - RANGE_DB)) / RANGE_DB, 0, 1)
            text = ";".join(str(int(v * 1000)) for v in lvl)
        frames.append((t0 + DELAY, text))
        now = time.time()
        while frames and frames[0][0] <= now:
            _, txt = frames.popleft()
            # Send unchanged frames (silence) only twice per second instead of 30 times
            if txt == current["text"] and now - sent < 0.5:
                continue
            sent = now
            with cond:
                current["text"] = txt
                current["seq"] += 1
                cond.notify_all()
        time.sleep(max(0.0, period - (time.time() - t0)))


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/status":
            with lock:
                st = dict(stream)
                sq, cnt = sum(l[0] for l in levels), sum(l[1] for l in levels)
            st["active"] = time.time() - st["last"] < 0.5
            # average level (dBFS) over up to the last 30 s of audio, for comparing the loudness of sources
            st["level_db"] = round(10 * np.log10(sq / cnt + 1e-12), 1) if cnt else None
            st["level_seconds"] = len(levels)
            body = json.dumps(st).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if path != "/spectrum":
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        seq = -1
        try:
            # Send every frame immediately. Otherwise TCP batches the small packets (Nagle) and waits
            # for the tablet's ACK: the bars then arrive late and in bursts.
            self.connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            self.wfile.write(b"retry: 2000\n\n")
            while True:
                with cond:
                    cond.wait_for(lambda: current["seq"] != seq, timeout=5)
                    seq, txt = current["seq"], current["text"]
                self.wfile.write(("data: " + txt + "\n\n").encode())
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass


if __name__ == "__main__":
    threading.Thread(target=receiver, daemon=True).start()
    threading.Thread(target=analyzer, daemon=True).start()
    print(f"Spectrum service on port {PORT}, {BANDS} bands, {FPS:.0f} fps, delay {DELAY*1000:.0f} ms")
    srv = ThreadingHTTPServer(("", PORT), Handler)
    srv.daemon_threads = True
    srv.serve_forever()
