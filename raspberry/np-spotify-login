#!/usr/bin/python3
"""Einmalige Spotify-Anmeldung fuer den Umschalter und die Spotify-Steuerung.

Laeuft auf dem Rechner, an dem du im Browser bei Spotify angemeldet bist
(nicht auf dem Pi):

    ./np-spotify-login <Client-ID>

Vorher bei https://developer.spotify.com/dashboard eine App anlegen und als
Redirect-URI genau  http://127.0.0.1:8888/callback  eintragen. Das Programm
oeffnet die Spotify-Anmeldeseite, nimmt die Antwort lokal entgegen und
schreibt das Ergebnis nach spotify.json (neben diesem Programm). Die Datei
enthaelt ein Zugangstoken fuer dein Konto: nicht einchecken, nicht weitergeben.
install.sh bringt sie auf dem Pi an ihren Platz.

Es wird kein Client-Secret gebraucht (Anmeldung mit PKCE).
"""
import base64
import hashlib
import http.server
import json
import os
import secrets
import sys
import urllib.parse
import urllib.request
import webbrowser

# Wiedergabe lesen und steuern; Hoerverlauf und Playlists fuer die Playlist-Auswahl am Tablet
SCOPES = ("user-read-playback-state user-modify-playback-state "
          "user-read-recently-played playlist-read-private")
PORT = 8888  # muss zur eingetragenen Redirect-URI passen
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "spotify.json")


def main():
    if len(sys.argv) != 2 or not sys.argv[1].strip():
        sys.exit("Aufruf: np-spotify-login <Client-ID>")
    client_id = sys.argv[1].strip()
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    result = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def do_GET(self):
            u = urllib.parse.urlsplit(self.path)
            q = urllib.parse.parse_qs(u.query)
            if u.path != "/callback":
                self.send_response(404)
                self.end_headers()
                return
            if q.get("state", [""])[0] != state:
                result["error"] = "Antwort passt nicht zu dieser Anmeldung (state)"
            elif "code" in q:
                result["code"] = q["code"][0]
            else:
                result["error"] = q.get("error", ["unbekannter Fehler"])[0]
            text = "Anmeldung angekommen. Dieses Fenster kann geschlossen werden." \
                if "code" in result else "Anmeldung fehlgeschlagen: " + result["error"]
            body = ("<!DOCTYPE html><meta charset='utf-8'><title>Now Playing</title>"
                    "<p style='font-family:sans-serif;margin:3em'>%s</p>" % text).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    srv = http.server.HTTPServer(("127.0.0.1", PORT), Handler)
    redirect = "http://127.0.0.1:%d/callback" % PORT
    url = "https://accounts.spotify.com/authorize?" + urllib.parse.urlencode({
        "response_type": "code", "client_id": client_id, "redirect_uri": redirect, "state": state,
        "scope": SCOPES, "code_challenge_method": "S256", "code_challenge": challenge})
    print("Bitte im Browser bei Spotify anmelden und zustimmen:\n\n  %s\n" % url, flush=True)
    webbrowser.open(url)
    while not result:
        srv.handle_request()
    srv.server_close()
    if "code" not in result:
        sys.exit("Anmeldung fehlgeschlagen: " + result["error"])

    data = urllib.parse.urlencode({"grant_type": "authorization_code", "code": result["code"],
                                   "redirect_uri": redirect, "client_id": client_id,
                                   "code_verifier": verifier}).encode()
    req = urllib.request.Request("https://accounts.spotify.com/api/token", data=data,
                                 headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            tok = json.loads(r.read())
    except urllib.error.HTTPError as e:
        sys.exit("Spotify hat die Anmeldung abgelehnt (HTTP %d)" % e.code)
    if not tok.get("refresh_token"):
        sys.exit("Spotify hat kein Refresh-Token geliefert")
    with open(os.open(OUT, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump({"refresh_token": tok["refresh_token"]}, f)
    print("Fertig. Anmeldung gespeichert in %s" % OUT)


if __name__ == "__main__":
    main()
