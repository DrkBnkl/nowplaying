[Unit]
Description=Now Playing display server (track info, cover art and controls for the tablet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/nowplaying
Environment=INDEX_FILE=/usr/local/share/nowplaying/index.html
ExecStart=/usr/local/bin/np-server
DynamicUser=yes
StateDirectory=nowplaying
Nice=5
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
