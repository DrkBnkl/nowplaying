# Einstellungen fuer den Now-Playing-Server. Auf dem Pi: /etc/default/nowplaying
# Nach Aenderungen:  sudo systemctl restart nowplaying

# --- Plex-Server (liefert Titel und Cover zu dem, was Caldera spielt) ---
# Adresse des Plex-Servers, z. B. http://192.168.1.20:32400
PLEX_URL=
# Plex-Token (siehe ANLEITUNG.md)
PLEX_TOKEN=

# --- WiiM Amp (Radio, AirPlay, Spotify direkt auf dem WiiM) ---
# IP-Adresse des WiiM, z. B. 192.168.1.30. Leer = aus.
WIIM_HOST=

# --- Spotify Connect auf dem Pi (Raspotify, Name "PlexAmpPi") ---
SPOTIFY_CONNECT=yes
# Spotify-Web-Schnittstelle fuer Umschalter, Skip und Stopp (siehe ANLEITUNG.md,
# einmalige Einrichtung mit np-spotify-login). Leer = aus.
SPOTIFY_CLIENT_ID=
# Name des Spotify-Connect-Geraets auf diesem Pi
SPOTIFY_DEVICE=PlexAmpPi

# --- Feintuning ---
# Sekunden, die nach Pause oder Ende der Musik das Cover noch stehen bleibt,
# dann geht das Display aus (an, sobald wieder Musik laeuft)
OFF_DELAY=10
# Anzahl Playlists in der Auswahl am Tablet (Favoriten zuerst, dann zuletzt gespielte)
PLAYLIST_COUNT=10
# Sekunden, die nach Pause/Stopp (Caldera, WiiM) das Cover mit Play-Knopf stehen bleibt
PAUSE_DELAY=180
# Spektrum-Dienst: auto = dieser Pi, Port 8090
SPECTRUM_URL=auto
# Port des Spektrum-Dienstes; nur aendern, wenn PORT in
# /etc/default/nowplaying-spectrum geaendert wurde
SPECTRUM_PORT=8090
