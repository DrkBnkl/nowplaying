def wiim_command(name):
    """Befehl an den WiiM, z. B. next oder stop."""
    http(f"https://{WIIM_HOST}/httpapi.asp?command=setPlayerCmd:{name}", insecure=True)


def poll_wiim():
    base = f"https://{WIIM_HOST}/httpapi.asp?command="
    _, raw, _ = http(base + "getPlayerStatus", insecure=True)
    st = json.loads(raw)
    if st.get("status") not in ("play", "pause"):
        return None
    _, raw, _ = http(base + "getMetaInfo", insecure=True)
    md = json.loads(raw).get("metaData", {}) or {}

    def clean(v):
        v = (v or "").strip()
        return "" if v.lower() in ("unknow", "unknown", "un_known", "null") else v

    title = clean(md.get("title"))
    art = clean(md.get("albumArtURI"))
    if not title and not art.startswith("http"):
        return None  # z. B. optischer Eingang (Pi) ohne Metadaten
    return {
        "source": "wiim",
        "device": "WiiM",
        "playing": st.get("status") == "play",
        "title": title,
        "artist": clean(md.get("artist")),
        "album": clean(md.get("album")),
        "art": register_art(art, insecure=True) if art.startswith("http") else None,
        "skip": True,
        "prev": True,
        "stop": True,
        "play": True,
        "time": num(st.get("curpos")),
        "duration": num(st.get("totlen")),
    }


SOURCES = {}
if CALDERA_URL and PLEX_URL and PLEX_TOKEN:
    SOURCES["caldera"] = poll_caldera
if WIIM_HOST:
    SOURCES["wiim"] = poll_wiim


def worker(name, fn):
    while True:
        try:
            item = fn()
            now = time.time()
            with lock:
                prev = state.get(name)
                if item:
                    same = prev and prev.get("title") == item["title"] \
                        and prev.get("playing") == item["playing"]
                    item["since"] = prev["since"] if same else now
                    item["seen"] = now
                state[name] = item
                errors.pop(name, None)
            if name == "caldera":
                check_conflict()
        except Exception as e:  # noqa: BLE001 – Quelle darf nie den Server killen
            with lock:
                errors[name] = f"{type(e).__name__}: {e}"
        time.sleep(INTERVAL[name])


last_shown = {"item": None, "t": 0.0}


def current():
    """Was das Tablet zeigen soll. Laeuft nichts mehr (Pause, Stopp, Quelle weg),
    bleibt das letzte Cover noch OFF_DELAY Sekunden abgedunkelt stehen."""
    now = time.time()
    with lock:
        items = [state.get(k) for k in ("caldera", "spotify", "wiim")]
    items = [i for i in items if i and (i.get("push") or now - i["seen"] < STALE_AFTER)]
    for i in items:
        if i["playing"]:
            last_shown["item"], last_shown["t"] = i, now
            return i
    # Pausiert und fortsetzbar: bleibt PAUSE_DELAY stehen, das Tablet zeigt den Play-Knopf
    paused = [i for i in items if (i.get("play") or (i["source"] == "spotify" and spotify_ready()))
              and now - i["since"] < PAUSE_DELAY]
    if paused:
        return dict(max(paused, key=lambda i: i["since"]), skip=False, prev=False, stop=False,
                    similar=False, similar_off=False, albumplay=False)
    last = last_shown["item"]
    if last and now - last_shown["t"] < OFF_DELAY:
        return dict(last, playing=False)
    return {"source": "idle"}


def shown():
    """Wie current(), aber ohne Musik bleibt der zuletzt gespielte Titel stehen (pausiert,
    "idle": True). Das Display ist dann aus; wird das Tablet von Hand geweckt, zeigt es den
    letzten Titel mit Play-Knopf, und die Wiedergabe laesst sich dort fortsetzen."""
    c = current()
    last = last_shown["item"]
    if c["source"] == "idle" and last:
        c = dict(last, playing=False, idle=True, skip=False, prev=False, stop=False, similar=False,
                 similar_off=False, albumplay=False)
        if c["source"] == "caldera":  # gestoppt: der Schalter stellt ein, wie die naechste Playlist startet
            c.update(shuffle=True, shuffled=shuffle_pref[0])
    if c["source"] == "spotify" and spotify_ready():  # ueber die Web-Schnittstelle steuerbar
        live = bool(c.get("playing"))
        c = dict(c, play=True, stop=live, skip=live, prev=live, albumplay=live, shuffle=True)
    return c


# Bedienung vom Tablet: nur Quellen, die sich steuern lassen. Spotify Connect auf dem Pi
# (librespot) hat keine lokale Steuerung; es geht nur mit eingerichteter Web-Schnittstelle.
# "stop" haelt die Wiedergabe an (Pause), damit "play" an derselben Stelle weiterspielen kann.
CONTROL = {
    "skip": {"caldera": lambda: caldera_command("skipNext"), "wiim": lambda: wiim_command("next"),
             "spotify": lambda: spotify_command("POST", "next")},
    "prev": {"caldera": lambda: caldera_command("skipPrevious"), "wiim": lambda: wiim_command("prev"),
             "spotify": lambda: spotify_command("POST", "previous")},
    "stop": {"caldera": lambda: caldera_command("pause"), "wiim": lambda: wiim_command("pause"),
             "spotify": lambda: spotify_command("PUT", "pause")},
    "play": {"caldera": play_caldera, "wiim": lambda: wiim_command("resume"), "spotify": spotify_play},
    "similar": {"caldera": similar_caldera},
    "albumplay": {"caldera": play_album_caldera, "spotify": play_album_spotify},
    "shuffle": {"caldera": shuffle_caldera, "spotify": shuffle_spotify},
}


def control(cmd):
    """Befehl (skip, prev, stop, play, similar) an die Quelle, die gerade angezeigt wird. False, wenn das nicht geht."""
    c = shown()
    fn = CONTROL[cmd].get(c.get("source")) if c.get(cmd) else None
    if not fn:
        return False
    return fn() is not False


