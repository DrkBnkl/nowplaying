# Display settings that survive reloads and restarts. "view": layout for Plex and Spotify,
# chosen on the tablet with the three-way view switch:
#   full  = all info with the LED bar
#   big   = no bar, large cover with info (like the WiiM view)
#   cover = cover only
VIEWS = ("full", "big", "cover")
SETTINGS_FILE = os.path.join(STATE_DIR, "settings.json")
settings = {"view": "full"}


def settings_load():
    try:
        with open(SETTINGS_FILE) as f:
            data = json.load(f)
        if data.get("view") in VIEWS:
            settings["view"] = data["view"]
    except (OSError, ValueError, AttributeError):
        pass


def set_view(view):
    """Choose a view (one of VIEWS); saved immediately. False for an unknown view."""
    if view not in VIEWS:
        return False
    with lock:
        settings["view"] = view
        tmp = SETTINGS_FILE + ".new"
        with open(tmp, "w") as f:
            json.dump(settings, f)
        os.replace(tmp, SETTINGS_FILE)
    return True


def set_favorite(source, pid, on):
    """Mark a playlist as a favorite or remove the mark; saved immediately."""
    with lock:
        cur = [x for x in favorites[source] if x != pid]
        if on:
            cur.append(pid)
        favorites[source] = cur
        tmp = FAVORITES_FILE + ".new"
        with open(tmp, "w") as f:
            json.dump(favorites, f)
        os.replace(tmp, FAVORITES_FILE)
    playlist_cache["t"] = spotify_pl_cache["t"] = 0.0
spotify_auth = {"refresh": None, "access": None, "expires": 0.0}
spotify_lock = threading.Lock()


def spotify_load():
    try:
        with open(SPOTIFY_TOKEN_FILE) as f:
            spotify_auth["refresh"] = json.load(f).get("refresh_token") or None
    except (OSError, ValueError):
        spotify_auth["refresh"] = None


def spotify_ready():
    return bool(SPOTIFY_CLIENT_ID and spotify_auth["refresh"])


def spotify_access():
    """Valid access token; renewed with the stored refresh token."""
    with spotify_lock:
        if spotify_auth["access"] and time.time() < spotify_auth["expires"] - 60:
            return spotify_auth["access"]
        data = urllib.parse.urlencode({"grant_type": "refresh_token", "client_id": SPOTIFY_CLIENT_ID,
                                       "refresh_token": spotify_auth["refresh"]}).encode()
        _, raw, _ = http("https://accounts.spotify.com/api/token",
                         {"Content-Type": "application/x-www-form-urlencoded"}, data=data, timeout=10)
        tok = json.loads(raw)
        spotify_auth["access"] = tok["access_token"]
        spotify_auth["expires"] = time.time() + float(tok.get("expires_in", 3600))
        new = tok.get("refresh_token")
        if new and new != spotify_auth["refresh"]:  # Spotify may rotate the refresh token
            spotify_auth["refresh"] = new
            tmp = SPOTIFY_TOKEN_FILE + ".new"
            with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
                json.dump({"refresh_token": new}, f)
            os.replace(tmp, SPOTIFY_TOKEN_FILE)
        return spotify_auth["access"]


def spotify_api(method, path, body=None):
    headers = {"Authorization": "Bearer " + spotify_access()}
    data = None
    if body is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(body).encode()
    elif method in ("PUT", "POST"):
        data = b""
    _, raw, _ = http("https://api.spotify.com/v1" + path, headers, data=data, timeout=10, method=method)
    try:  # on success the player commands reply sometimes empty, sometimes with text instead of JSON
        return json.loads(raw) if raw else {}
    except ValueError:
        return {}


def spotify_device():
    """This Pi's Spotify Connect device in the Spotify account (id, is_active ...), None if it is missing there."""
    for d in spotify_api("GET", "/me/player/devices").get("devices") or []:
        if (d.get("name") or "").lower() == SPOTIFY_DEVICE.lower():
            return d
    return None


def spotify_play():
    """Play (or resume) Spotify on this Pi. If the Pi is not yet the account's active device,
    playback is transferred here; an explicit "play" starts it in any case
    (the transfer alone does not start playback if the Pi already is the active device)."""
    dev = spotify_device()
    if not dev:
        return False
    if not dev.get("is_active"):
        spotify_api("PUT", "/me/player", {"device_ids": [dev["id"]], "play": True})
        time.sleep(1)
    try:
        spotify_api("PUT", "/me/player/play?device_id=" + urllib.parse.quote(dev["id"]))
    except urllib.error.HTTPError as e:
        if e.code != 403:  # 403 = already playing
            raise
    return True


def shuffle_spotify():
    """Toggle shuffle on Spotify."""
    dev = spotify_device()
    on = not spotify_api("GET", "/me/player").get("shuffle_state")
    spotify_api("PUT", "/me/player/shuffle?state=%s%s" % (
        "true" if on else "false", "&device_id=" + urllib.parse.quote(dev["id"]) if dev else ""))
    with lock:
        cur = state.get("spotify")
        if cur:
            cur["shuffled"] = on
    return True


def play_album_spotify():
    """Play the album of the current Spotify track from track 1."""
    dev = spotify_device()
    album = ((spotify_api("GET", "/me/player").get("item") or {}).get("album") or {}).get("uri")
    if not dev or not album:
        return False
    spotify_api("PUT", "/me/player/play?device_id=" + urllib.parse.quote(dev["id"]),
                {"context_uri": album, "offset": {"position": 0}})
    return True


def spotify_command(method, name):
    dev = spotify_device()
    spotify_api(method, "/me/player/%s%s" % (name, "?device_id=" + urllib.parse.quote(dev["id"]) if dev else ""))


spotify_pl_cache = {"t": 0.0, "items": []}
spotify_pl_info = {}   # uri -> name, image, count (rarely changes, saves requests)


def spotify_playlists():
    """Spotify playlists for the picker on the tablet: favorites first, then the most recently
    played (from the account's listening history), filled up with the user's own playlists.
    Playlists whose details Spotify does not disclose are skipped."""
    if time.time() - spotify_pl_cache["t"] < 60:
        return spotify_pl_cache["items"]
    favs = list(favorites["spotify"])
    uris = list(favs)

    def add(ctx):
        if ctx and ctx.get("type") == "playlist" and ctx.get("uri") and ctx["uri"] not in uris:
            uris.append(ctx["uri"])

    def info(uri, pl):
        img = (pl.get("images") or [{}])[0].get("url")
        spotify_pl_info[uri] = {"title": pl.get("name") or "", "img": img,
                                "count": ((pl.get("tracks") or pl.get("items") or {}).get("total")) or 0}
    try:
        add(spotify_api("GET", "/me/player").get("context"))
    except Exception:  # noqa: BLE001 – nothing active
        pass
    try:
        for it in spotify_api("GET", "/me/player/recently-played?limit=50").get("items") or []:
            add(it.get("context"))
    except Exception:  # noqa: BLE001 – listening history not permitted
        pass
    try:
        for pl in spotify_api("GET", "/me/playlists?limit=30").get("items") or []:
            if pl and pl.get("uri"):
                info(pl["uri"], pl)
                if pl["uri"] not in uris:
                    uris.append(pl["uri"])
    except Exception:  # noqa: BLE001
        pass
    items = []
    for uri in uris:
        if len(items) >= PLAYLIST_COUNT:
            break
        if uri not in spotify_pl_info:
            try:
                info(uri, spotify_api("GET", "/playlists/" + uri.rsplit(":", 1)[1]))
            except Exception:  # noqa: BLE001 – e.g. playlists created by Spotify
                continue
        i = spotify_pl_info[uri]
        if i["title"]:
            items.append({"id": uri, "title": i["title"], "count": i["count"],
                          "art": register_art(i["img"]) if i["img"] else None, "fav": uri in favs})
    spotify_pl_cache["t"], spotify_pl_cache["items"] = time.time(), items
    return items


def start_spotify_playlist(uri):
    """Start a Spotify playlist on this Pi. Only playlists from the picker list."""
    if uri not in [p["id"] for p in spotify_playlists()]:
        return False
    dev = spotify_device()
    if not dev:
        return False
    spotify_api("PUT", "/me/player/play?device_id=" + urllib.parse.quote(dev["id"]), {"context_uri": uri})
    spotify_pl_cache["t"] = 0.0
    return True


def playlist_source():
    """Whose playlists the tablet currently offers: "spotify", "caldera" or None.
    Starting a playlist replaces what the source is playing, so never offer those of
    another source while something is playing."""
    c = shown()
    if c.get("source") == "wiim":
        return None  # WiiM view: only the switch, no playlists
    if c.get("source") == "spotify":
        return "spotify" if spotify_ready() else None
    if "caldera" in SOURCES and (c.get("source") in ("caldera", "idle") or not c.get("playing")):
        return "caldera"
    return None


def wait_card_free(timeout=10.0):
    """Wait until no program has the sound card open. Caldera releases it only 5 s after
    pausing, librespot shortly after pausing. If the other player starts earlier, it gets
    "device busy": Caldera then stays silent, librespot exits."""
    end = time.time() + timeout
    while time.time() < end:
        busy = False
        for f in glob.glob("/proc/asound/card*/pcm*p/sub*/status"):
            try:
                with open(f) as fh:
                    busy = busy or fh.read().strip() != "closed"
            except OSError:
                pass
        if not busy:
            return True
        time.sleep(0.25)
    return False


def note(text):
    """Write a line to the log (journalctl -u nowplaying). Records who controls playback:
    Caldera and Spotify do not report the sender of a command."""
    print(text, flush=True)


switching = threading.Lock()   # one source switch at a time
last_switch = [0.0]


def caldera_resumable():
    """Can Plex resume right away? Caldera holds a track, or the last queue is known."""
    with lock:
        held = bool(state.get("caldera"))
    return "caldera" in SOURCES and (held or bool(caldera_last.get("queue") and caldera_last.get("key")))


def switch_source():
    """Plex <-> Spotify switch: pause the current source, play (or resume) the other."""
    with switching:
        try:
            if shown().get("source") == "wiim":
                # Music directly on the WiiM: set the WiiM to the optical input (Pi), Plex resumes
                if not caldera_resumable():
                    return False
                try:
                    wiim_command("pause")
                except Exception:  # noqa: BLE001 – e.g. radio cannot be paused
                    pass
                wiim_command("switchmode:optical")
                return play_caldera()
            if shown().get("source") == "spotify":
                if "caldera" not in SOURCES:
                    return False
                try:
                    spotify_command("PUT", "pause")
                except Exception:  # noqa: BLE001 – already stopped playing
                    pass
                wait_card_free()
                return play_caldera()
            if not spotify_ready() or not spotify_device():
                return False
            if "caldera" in SOURCES:
                tl = caldera_timeline()
                if tl is not None and tl.get("state") != "paused":
                    caldera_command("pause")
            wait_card_free()
            return spotify_play()
        finally:
            last_switch[0] = time.time()


pi_playing = [None]   # was Plex or Spotify playing on the Pi at the last check? (None: not known yet)


def wiim_follow():
    """If Plex or Spotify starts playing on the Pi while the WiiM is not on the optical input
    (its own music: radio, AirPlay ..., even paused), the Pi would be silent: switch the WiiM
    over. Only at the moment playback starts; whoever picks something else on the WiiM later keeps it."""
    with lock:
        now_playing = any((state.get(k) or {}).get("playing") for k in ("caldera", "spotify"))
        started = now_playing and pi_playing[0] is False
        pi_playing[0] = now_playing
    if not started or switching.locked():
        return
    try:
        if wiim_mode() == WIIM_OPTICAL:
            return
        note("Automatic: music started on the Pi, switching the WiiM to the optical input")
        wiim_command("switchmode:optical")
    except Exception as e:  # noqa: BLE001 – WiiM unreachable
        with lock:
            errors["wiim-input"] = f"{type(e).__name__}: {e}"


wiim_seen = [False]   # first look at the WiiM after startup: don't pause anything


def wiim_started(prev, item):
    """The reverse: if the WiiM starts playing its own music (e.g. Spotify Connect on the WiiM)
    while Plex or Spotify is playing on the Pi, the Pi can no longer be heard: pause it so the
    tablet switches to the WiiM as well. Only at the moment playback starts on the WiiM."""
    first, wiim_seen[0] = not wiim_seen[0], True
    began = bool(item and item.get("playing")) and not (prev and prev.get("playing"))
    if first or not began or switching.locked():
        return
    with lock:
        busy = [k for k in ("caldera", "spotify") if (state.get(k) or {}).get("playing")]
    for k in busy:
        note(f"Automatic: music started on the WiiM, pausing {'Plex' if k == 'caldera' else 'Spotify'} on the Pi")
        try:
            if k == "caldera":
                caldera_command("pause")
            else:
                spotify_command("PUT", "pause")
        except Exception as e:  # noqa: BLE001 – source unreachable
            with lock:
                errors["wiim-priority"] = f"{type(e).__name__}: {e}"


def check_conflict():
    """Only one source may play at a time. If someone starts Spotify while Plex is playing (or
    vice versa, e.g. from a phone), the most recently started one wins; the other is paused."""
    if "wiim" in SOURCES:
        wiim_follow()
    with lock:
        c, sp = state.get("caldera"), state.get("spotify")
        both = bool(c and sp and c.get("playing") and sp.get("playing"))
        winner = "spotify" if both and sp["since"] >= c["since"] else "caldera"
    if not both or switching.locked() or time.time() - last_switch[0] < 15:
        return
    if winner == "caldera" and not spotify_ready():
        return  # without the Web API Spotify cannot be paused
    threading.Thread(target=resolve_conflict, args=(winner,), daemon=True).start()


def resolve_conflict(winner):
    if not switching.acquire(blocking=False):
        return
    loser = "Plex" if winner == "spotify" else "Spotify"
    note(f"Automatic (only one source at a time): pausing {loser}, {winner} keeps playing")
    try:
        if winner == "spotify":
            tl = caldera_timeline()
            if tl is not None and tl.get("state") != "paused":
                caldera_command("pause")
            wait_card_free()
            # If the sound card was busy, librespot exited and is restarting right now:
            # wait until the device is back in the account, then transfer playback to it
            for _ in range(15):
                if not spotify_ready():
                    break
                try:
                    if spotify_play():
                        break
                except Exception:  # noqa: BLE001
                    pass
                time.sleep(3)
        else:
            try:
                spotify_command("PUT", "pause")
            except Exception:  # noqa: BLE001
                pass
            wait_card_free()
            # Caldera did not get the sound card when it started and stays silent: restart it
            caldera_command("pause")
            time.sleep(0.5)
            caldera_command("play")
    except Exception as e:  # noqa: BLE001
        with lock:
            errors["switch"] = f"{type(e).__name__}: {e}"
    finally:
        last_switch[0] = time.time()
        switching.release()


# ------------------------------------------- Spotify Connect (librespot)
def best_cover(covers):
    """Pick the largest cover. librespot does not reliably sort the sizes;
    Spotify image URLs carry the size in the name (0000b273 = 640 px album, 0000ba8a = 640 px podcast)."""
    for mark in ("0000b273", "0000ba8a"):
        for c in covers:
            if mark in c:
                return c
    return covers[0]


def watch_librespot():
    """librespot only reports events. If the process ends without "stopped"
    (crash, Raspotify restart), the last track would count as playing forever."""
    while True:
        time.sleep(5)
        with lock:
            cur = state.get("spotify")
            pid = cur.get("pid") if cur else None
            if pid and not os.path.exists(f"/proc/{pid}"):
                state["spotify"] = None


def librespot_event(ev):
    """Handle an event from np-librespot-event."""
    kind = ev.get("event", "")
    now = time.time()
    # librespot's process ID; only remember it if we can actually see the process
    pid = ev.get("pid")
    if not (isinstance(pid, int) and pid > 1 and os.path.exists(f"/proc/{pid}")):
        pid = None
    with lock:
        cur = state.get("spotify")
        if kind in ("stopped", "session_disconnected"):
            state["spotify"] = None
            return
        if kind == "track_changed":
            covers = [c for c in (ev.get("covers") or "").splitlines() if c.startswith("http")]
            item = {"source": "spotify", "device": "PlexAmpPi", "push": True,
                    "playing": bool(cur and cur.get("playing")),
                    "title": ev.get("name", ""),
                    "artist": ", ".join(a for a in (ev.get("artists") or ev.get("show_name") or "").splitlines() if a),
                    "album": ev.get("album", ""), "art": None, "track": ev.get("track_id", ""),
                    "pid": pid or (cur and cur.get("pid"))}
            if covers:
                item["art"] = best_cover(covers)  # registered outside the lock
            item["since"] = now
            item["seen"] = now
            state["spotify"] = item
        elif kind in ("playing", "paused") and cur:
            playing = kind == "playing"
            if cur.get("playing") != playing:
                cur["since"] = now
            cur["playing"] = playing
            cur["seen"] = now
            if pid:
                cur["pid"] = pid
        elif kind == "playing":
            # playback is running, track details follow with track_changed
            state["spotify"] = {"source": "spotify", "device": "PlexAmpPi", "push": True,
                                "playing": True, "title": "", "artist": "", "album": "",
                                "art": None, "since": now, "seen": now, "pid": pid}
        errors.pop("spotify", None)
        item = state.get("spotify")
        url = item.get("art") if item else None
    if url and url.startswith("http"):
        key = register_art(url)
        with lock:
            if state.get("spotify") is item:
                item["art"] = key
        prefetch_art(key)
    if item and kind in ("track_changed", "playing") and spotify_ready():
        threading.Thread(target=spotify_enrich, args=(item,), daemon=True).start()
    if kind in ("track_changed", "playing"):
        check_conflict()


def spotify_sync():
    """Every 10 s, check with the Spotify account whether this Pi is playing. librespot only
    reports events; after a restart of this server or a missed event it would otherwise
    not know that Spotify is playing (important for "only one source at a time")."""
    while True:
        time.sleep(10)
        if not spotify_ready():
            continue
        try:
            p = spotify_api("GET", "/me/player")
            here = ((p.get("device") or {}).get("name") or "").lower() == SPOTIFY_DEVICE.lower()
            playing = bool(here and p.get("is_playing"))
            now, found = time.time(), None
            with lock:
                cur = state.get("spotify")
                if playing and not (cur and cur.get("playing")):
                    if cur:
                        cur.update(playing=True, seen=now)
                    else:
                        # "since" 0: was already playing before; another source just started counts as newer
                        cur = state["spotify"] = {
                            "source": "spotify", "device": "PlexAmpPi", "push": True, "playing": True,
                            "title": "", "artist": "", "album": "", "art": None,
                            "since": 0.0, "seen": now, "pid": None}
                    found = cur
                elif cur and cur.get("playing") and not playing and now - cur.get("seen", 0) > 15:
                    cur.update(playing=False, since=now)  # according to the account no longer playing here
            if found:
                spotify_enrich(found)
                check_conflict()
        except Exception:  # noqa: BLE001 – Spotify unreachable
            pass


def spotify_enrich(item):
    """Use the Web API to add what librespot does not report: the playlist name and, if still
    empty (server restarted, playback resumed), title, artist and cover."""
    time.sleep(1.5)  # Spotify needs a moment before the new state can be fetched
    try:
        p = spotify_api("GET", "/me/player")
        ctx, name, kind = p.get("context") or {}, "", ""
        tr_ = p.get("item") or {}
        if ctx.get("type") == "album" and tr_.get("track_number") and (tr_.get("album") or {}).get("total_tracks"):
            kind, name = "album", tr("track_n_of_m", n=tr_["track_number"], m=tr_["album"]["total_tracks"])
        if ctx.get("type") == "playlist" and ctx.get("uri"):
            kind = "playlist"
            uri = ctx["uri"]
            if uri not in spotify_pl_info:
                pl = spotify_api("GET", "/playlists/" + uri.rsplit(":", 1)[1])
                spotify_pl_info[uri] = {"title": pl.get("name") or "", "count": 0,
                                        "img": (pl.get("images") or [{}])[0].get("url")}
            name = spotify_pl_info[uri]["title"]
        t = p.get("item") or {}
        art = None
        img = ((t.get("album") or {}).get("images") or t.get("images") or [{}])[0].get("url")
        if img:
            art = register_art(img)
        with lock:
            if state.get("spotify") is not item:
                return
            item["playlist"], item["context"] = name, kind if name else ""
            item["shuffled"] = bool(p.get("shuffle_state"))
            if not item.get("title") and t.get("name"):
                item["title"] = t["name"]
                item["artist"] = ", ".join(a.get("name", "") for a in t.get("artists") or [])
                item["album"] = (t.get("album") or {}).get("name", "")
                item["art"] = item.get("art") or art
        if art:
            prefetch_art(art)
    except Exception:  # noqa: BLE001 – works without the extra details too
        pass


# ---------------------------------------------------------------- WiiM
def wiim_command(name):
    """Send a command to the WiiM, e.g. next or stop."""
    http(f"https://{WIIM_HOST}/httpapi.asp?command=setPlayerCmd:{name}", insecure=True)


WIIM_OPTICAL = "43"   # the WiiM's "mode" when it plays the optical input (Pi)


def wiim_mode():
    """Input the WiiM is currently set to (the "mode" field of its status)."""
    _, raw, _ = http(f"https://{WIIM_HOST}/httpapi.asp?command=getPlayerStatus", insecure=True)
    return str(json.loads(raw).get("mode"))


def poll_wiim():
    base = f"https://{WIIM_HOST}/httpapi.asp?command="
    _, raw, _ = http(base + "getPlayerStatus", insecure=True)
    st = json.loads(raw)
    if st.get("status") not in ("play", "pause"):
        return None
    _, raw, _ = http(base + "getMetaInfo", insecure=True)
    md = json.loads(raw).get("metaData", {}) or {}

    def clean(v):
        v = (v or "").strip()
        return "" if v.lower() in ("unknow", "unknown", "un_known", "null") else v

    title = clean(md.get("title"))
    art = clean(md.get("albumArtURI"))
    if not title and not art.startswith("http"):
        return None  # e.g. optical input (Pi) without metadata
    return {
        "source": "wiim",
        "device": "WiiM",
        "playing": st.get("status") == "play",
        "title": title,
        "artist": clean(md.get("artist")),
        "album": clean(md.get("album")),
        "art": register_art(art, insecure=True) if art.startswith("http") else None,
        "skip": True,
        "prev": True,
        "stop": True,
        "play": True,
        "time": num(st.get("curpos")),
        "duration": num(st.get("totlen")),
    }


SOURCES = {}
if CALDERA_URL and PLEX_URL and PLEX_TOKEN:
    SOURCES["caldera"] = poll_caldera
if WIIM_HOST:
    SOURCES["wiim"] = poll_wiim


def worker(name, fn):
    while True:
        try:
            item = fn()
            now = time.time()
            with lock:
                prev = state.get(name)
                if item:
                    same = prev and prev.get("title") == item["title"] \
                        and prev.get("playing") == item["playing"]
                    item["since"] = prev["since"] if same else now
                    item["seen"] = now
                state[name] = item
                errors.pop(name, None)
            if name == "caldera":
                check_conflict()
            elif name == "wiim":
                wiim_started(prev, item)
        except Exception as e:  # noqa: BLE001 – a source must never kill the server
            with lock:
                errors[name] = f"{type(e).__name__}: {e}"
        time.sleep(INTERVAL[name])


last_shown = {"item": None, "t": 0.0}


def current():
    """What the tablet should show. When nothing is playing any more (pause, stop, source gone),
    the last cover stays up dimmed for OFF_DELAY seconds."""
    now = time.time()
    with lock:
        items = [state.get(k) for k in ("caldera", "spotify", "wiim")]
    items = [i for i in items if i and (i.get("push") or now - i["seen"] < STALE_AFTER)]
    for i in items:
        if i["playing"]:
            last_shown["item"], last_shown["t"] = i, now
            return i
    # Paused and resumable: stays up for PAUSE_DELAY, the tablet shows the Play button
    paused = [i for i in items if (i.get("play") or (i["source"] == "spotify" and spotify_ready()))
              and now - i["since"] < PAUSE_DELAY]
    if paused:
        p = max(paused, key=lambda i: i["since"])
        # The other buttons don't work while paused but stay on the tablet, greyed out
        dimmed = [k for k in ("albumplay", "similar", "prev", "skip") if p.get(k)]
        if p.get("similar_off") and "similar" not in dimmed:
            dimmed.append("similar")
        return dict(p, skip=False, prev=False, stop=False, similar=False, similar_off=False,
                    albumplay=False, dimmed=dimmed)
    last = last_shown["item"]
    if last and now - last_shown["t"] < OFF_DELAY:
        return dict(last, playing=False)
    return {"source": "idle"}


def shown():
    """Like current(), but without music the last played track stays (paused,
    "idle": True). The display is off then; if the tablet is woken by hand, it shows the
    last track with a Play button, and playback can be resumed from there."""
    c = current()
    last = last_shown["item"]
    if c["source"] == "idle" and last:
        c = dict(last, playing=False, idle=True, skip=False, prev=False, stop=False, similar=False,
                 similar_off=False, albumplay=False)
        if c["source"] == "caldera":  # stopped: the toggle sets how the next playlist starts
            c.update(shuffle=True, shuffled=shuffle_pref[0])
    if c["source"] == "spotify" and spotify_ready():  # controllable through the Web API
        live = bool(c.get("playing"))
        c = dict(c, play=True, stop=live, skip=live, prev=live, albumplay=live, shuffle=True)
    return c


# Controls from the tablet: only for sources that can be controlled. Spotify Connect on the Pi
# (librespot) has no local control; it only works with the Web API set up.
# "stop" pauses playback so that "play" can resume at the same position.
CONTROL = {
    "skip": {"caldera": lambda: caldera_command("skipNext"), "wiim": lambda: wiim_command("next"),
             "spotify": lambda: spotify_command("POST", "next")},
    "prev": {"caldera": lambda: caldera_command("skipPrevious"), "wiim": lambda: wiim_command("prev"),
             "spotify": lambda: spotify_command("POST", "previous")},
    "stop": {"caldera": lambda: caldera_command("pause"), "wiim": lambda: wiim_command("pause"),
             "spotify": lambda: spotify_command("PUT", "pause")},
    "play": {"caldera": play_caldera, "wiim": lambda: wiim_command("resume"), "spotify": spotify_play},
    "similar": {"caldera": similar_caldera},
    "albumplay": {"caldera": play_album_caldera, "spotify": play_album_spotify},
    "shuffle": {"caldera": shuffle_caldera, "spotify": shuffle_spotify},
}


def control(cmd):
    """Send a command (skip, prev, stop, play, similar ...) to the source currently shown. False if that is not possible."""
    c = shown()
    fn = CONTROL[cmd].get(c.get("source")) if c.get(cmd) else None
    if not fn:
        return False
    return fn() is not False


