                st = f"OK – {'spielt' if i['playing'] else 'Pause'}: {i['artist']} – {i['title']}"
            else:
                st = "OK – nichts aktiv"
            rows += f"<tr><td><b>{escape(label)}</b></td><td>{escape(st)}</td></tr>"
    return f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Setup</title>
<style>body{{font-family:sans-serif;max-width:700px;margin:2em auto;padding:0 1em}}
td{{padding:4px 8px;vertical-align:top}}</style></head><body>
<h1>Now Playing – Status</h1><table>{rows}</table>
<p>Spotify-Steuerung (Umschalter, Skip, Stopp): {"eingerichtet" if spotify_ready() else "nicht eingerichtet"}</p>
<p>Einstellungen: <code>/etc/default/nowplaying</code> auf dem Pi, danach
<code>sudo systemctl restart nowplaying</code>.</p>
<p><a href="/">→ Anzeige</a></p></body></html>""".encode()


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def send(self, code, body, ctype, cache="no-store"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", cache)
        self.end_headers()
        self.wfile.write(body)

    def spectrum_url(self):
        if SPECTRUM_URL.lower() != "auto":
            return SPECTRUM_URL
        host = self.headers.get("Host") or ""
        if host.startswith("["):  # IPv6-Adresse in Klammern, Port dahinter
            host = host[:host.find("]") + 1]
        else:
            host = host.rsplit(":", 1)[0]
        if not host or host in ("127.0.0.1", "localhost"):
            host = "127.0.0.1"
        return f"http://{host}:{SPECTRUM_PORT}/spectrum"

    def do_GET(self):
        path = self.path.split("?")[0]
        if path in ("/", "/index.html"):
            return self.send(200, INDEX, "text/html; charset=utf-8")
        if path == "/api/now":
            c = dict(shown())
            for k in ("since", "seen", "push", "track", "pid", "album_key", "analysed"):
                c.pop(k, None)
            c["display"] = "off" if c["source"] == "idle" or c.pop("idle", False) else "on"
            c["playlists"] = playlist_source() is not None
            # Umschalter: wohin er fuehrt ("plex" / "spotify"), leer wenn er nicht geht
            c["switch"] = ""
            if spotify_ready() and "caldera" in SOURCES and c["source"] in ("caldera", "spotify"):
                c["switch"] = "plex" if c["source"] == "spotify" else "spotify"
            for k in CONTROL:
                c[k] = bool(c.get(k))
            c["spectrum"] = self.spectrum_url()
            c["page"] = INDEX_VERSION
            return self.send(200, json.dumps(c).encode(), "application/json")
        if path.startswith("/art/"):
            try:
                art = get_art(path[5:])
            except Exception:  # noqa: BLE001
                art = None
            if not art:
                return self.send(404, b"", "text/plain")
            return self.send(200, art[0], art[1], "max-age=86400")
        if path == "/api/playlists":
            try:
                src = playlist_source()
                items = spotify_playlists() if src == "spotify" else playlists() if src == "caldera" else []
            except Exception:  # noqa: BLE001 – Plex bzw. Spotify nicht erreichbar
                items = []
            return self.send(200, json.dumps(items).encode(), "application/json")
        if path == "/setup":
            return self.send(200, setup_page(), "text/html; charset=utf-8")
        self.send(404, b"not found", "text/plain")

    def do_POST(self):
        path = self.path.split("?")[0]
        try:
            n = int(self.headers.get("Content-Length", 0) or 0)
        except ValueError:
            n = 0
        body = self.rfile.read(n) if n > 0 else b""
        if path.startswith("/api/") and path[5:] in CONTROL:
            # Eigener Kopf: fremde Webseiten koennen ihn im Browser nicht ungefragt mitsenden
            if self.headers.get("X-NowPlaying") != "1":
                return self.send(403, b"", "text/plain")
            try:
                ok = control(path[5:])
            except Exception:  # noqa: BLE001 – Quelle nicht erreichbar
                ok = False
            return self.send(204 if ok else 409, b"", "text/plain")
        if path == "/api/switch":
            if self.headers.get("X-NowPlaying") != "1":
                return self.send(403, b"", "text/plain")
            try:
                ok = switch_source()
            except Exception:  # noqa: BLE001 – Spotify oder Caldera nicht erreichbar
                ok = False
            return self.send(204 if ok else 409, b"", "text/plain")
        if path == "/api/favorite":
            if self.headers.get("X-NowPlaying") != "1":
                return self.send(403, b"", "text/plain")
            qs = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            pid, on = qs.get("id", [""])[0], qs.get("on", ["1"])[0] == "1"
            try:
                src = playlist_source()
                known = spotify_playlists() if src == "spotify" else playlists() if src == "caldera" else []
                ok = pid in [p["id"] for p in known]   # nur Playlists aus der gezeigten Liste
                if ok:
                    set_favorite(src, pid, on)
            except Exception:  # noqa: BLE001
                ok = False
            return self.send(204 if ok else 409, b"", "text/plain")
        if path == "/api/playlist":
            if self.headers.get("X-NowPlaying") != "1":
                return self.send(403, b"", "text/plain")
            pid = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query).get("id", [""])[0]
            try:
                if pid.startswith("spotify:playlist:"):
                    ok = playlist_source() == "spotify" and start_spotify_playlist(pid)
                else:
                    ok = playlist_source() == "caldera" and start_playlist(pid)
            except Exception:  # noqa: BLE001 – Plex, Caldera oder Spotify nicht erreichbar
                ok = False
            return self.send(204 if ok else 409, b"", "text/plain")
        if path != "/api/librespot":
            return self.send(404, b"", "text/plain")
        if self.client_address[0] not in ("127.0.0.1", "::1"):
            return self.send(403, b"", "text/plain")
        try:
            librespot_event(json.loads(body or b"{}"))
        except Exception as e:  # noqa: BLE001
            with lock:
                errors["spotify"] = f"{type(e).__name__}: {e}"
        self.send(204, b"", "text/plain")


if __name__ == "__main__":
    for name, fn in SOURCES.items():
        threading.Thread(target=worker, args=(name, fn), daemon=True).start()
    spotify_load()
    favorites_load()
    threading.Thread(target=spotify_sync, daemon=True).start()
    if SPOTIFY_CONNECT:
        threading.Thread(target=watch_librespot, daemon=True).start()
    active = list(SOURCES) + (["spotify"] if SPOTIFY_CONNECT else [])
    print(f"Now Playing auf Port {PORT}, Quellen: {', '.join(active) or 'keine'}")
    srv = ThreadingHTTPServer(("", PORT), Handler)
    srv.daemon_threads = True
    srv.serve_forever()
