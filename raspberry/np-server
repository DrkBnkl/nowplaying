SPOTIFY_DEVICE = os.environ.get("SPOTIFY_DEVICE", "PlexAmpPi")
STATE_DIR = os.environ.get("STATE_DIRECTORY", "").split(":")[0] or os.path.dirname(os.path.abspath(__file__))
SPOTIFY_TOKEN_FILE = os.path.join(STATE_DIR, "spotify.json")

# Playlist-Auswahl am Tablet: so viele Eintraege, Favoriten zuerst, dann die zuletzt gespielten
PLAYLIST_COUNT = int(os.environ.get("PLAYLIST_COUNT", "10"))
FAVORITES_FILE = os.path.join(STATE_DIR, "favorites.json")
favorites = {"caldera": [], "spotify": []}   # Quelle -> Playlist-Kennungen, in der Reihenfolge des Markierens


def favorites_load():
    try:
        with open(FAVORITES_FILE) as f:
            data = json.load(f)
        for k in favorites:
            favorites[k] = [str(x) for x in data.get(k) or []]
    except (OSError, ValueError, AttributeError):
        pass


def set_favorite(source, pid, on):
    """Playlist als Favorit markieren oder die Markierung entfernen; wird sofort gespeichert."""
    with lock:
        cur = [x for x in favorites[source] if x != pid]
        if on:
            cur.append(pid)
        favorites[source] = cur
        tmp = FAVORITES_FILE + ".neu"
        with open(tmp, "w") as f:
            json.dump(favorites, f)
        os.replace(tmp, FAVORITES_FILE)
    playlist_cache["t"] = spotify_pl_cache["t"] = 0.0
spotify_auth = {"refresh": None, "access": None, "expires": 0.0}
spotify_lock = threading.Lock()


def spotify_load():
    try:
        with open(SPOTIFY_TOKEN_FILE) as f:
            spotify_auth["refresh"] = json.load(f).get("refresh_token") or None
    except (OSError, ValueError):
        spotify_auth["refresh"] = None


def spotify_ready():
    return bool(SPOTIFY_CLIENT_ID and spotify_auth["refresh"])


def spotify_access():
    """Gueltiges Zugriffstoken; wird mit dem gespeicherten Refresh-Token erneuert."""
    with spotify_lock:
        if spotify_auth["access"] and time.time() < spotify_auth["expires"] - 60:
            return spotify_auth["access"]
        data = urllib.parse.urlencode({"grant_type": "refresh_token", "client_id": SPOTIFY_CLIENT_ID,
                                       "refresh_token": spotify_auth["refresh"]}).encode()
        _, raw, _ = http("https://accounts.spotify.com/api/token",
                         {"Content-Type": "application/x-www-form-urlencoded"}, data=data, timeout=10)
        tok = json.loads(raw)
        spotify_auth["access"] = tok["access_token"]
        spotify_auth["expires"] = time.time() + float(tok.get("expires_in", 3600))
        new = tok.get("refresh_token")
        if new and new != spotify_auth["refresh"]:  # Spotify kann das Refresh-Token austauschen
            spotify_auth["refresh"] = new
            tmp = SPOTIFY_TOKEN_FILE + ".neu"
            with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
                json.dump({"refresh_token": new}, f)
            os.replace(tmp, SPOTIFY_TOKEN_FILE)
        return spotify_auth["access"]


def spotify_api(method, path, body=None):
    headers = {"Authorization": "Bearer " + spotify_access()}
    data = None
    if body is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(body).encode()
    elif method in ("PUT", "POST"):
        data = b""
    _, raw, _ = http("https://api.spotify.com/v1" + path, headers, data=data, timeout=10, method=method)
    try:  # die Player-Befehle antworten bei Erfolg teils leer, teils mit Text statt JSON
        return json.loads(raw) if raw else {}
    except ValueError:
        return {}


def spotify_device():
    """Das Spotify-Connect-Geraet auf diesem Pi im Spotify-Konto (id, is_active ...), None wenn es dort fehlt."""
    for d in spotify_api("GET", "/me/player/devices").get("devices") or []:
        if (d.get("name") or "").lower() == SPOTIFY_DEVICE.lower():
            return d
    return None


def spotify_play():
    """Spotify auf diesem Pi (weiter)spielen. Ist der Pi noch nicht das aktive Geraet des Kontos,
    wird die Wiedergabe hierher geholt; ein ausdrueckliches "play" startet sie in jedem Fall
    (das Holen allein startet nicht, wenn der Pi schon das aktive Geraet ist)."""
    dev = spotify_device()
    if not dev:
        return False
    if not dev.get("is_active"):
        spotify_api("PUT", "/me/player", {"device_ids": [dev["id"]], "play": True})
        time.sleep(1)
    try:
        spotify_api("PUT", "/me/player/play?device_id=" + urllib.parse.quote(dev["id"]))
    except urllib.error.HTTPError as e:
        if e.code != 403:  # 403 = spielt bereits
            raise
    return True


def shuffle_spotify():
    """Zufallswiedergabe bei Spotify ein- oder ausschalten."""
    dev = spotify_device()
    on = not spotify_api("GET", "/me/player").get("shuffle_state")
    spotify_api("PUT", "/me/player/shuffle?state=%s%s" % (
        "true" if on else "false", "&device_id=" + urllib.parse.quote(dev["id"]) if dev else ""))
    with lock:
        cur = state.get("spotify")
        if cur:
            cur["shuffled"] = on
    return True


def play_album_spotify():
    """Das Album des laufenden Spotify-Titels von Titel 1 an spielen."""
    dev = spotify_device()
    album = ((spotify_api("GET", "/me/player").get("item") or {}).get("album") or {}).get("uri")
    if not dev or not album:
        return False
    spotify_api("PUT", "/me/player/play?device_id=" + urllib.parse.quote(dev["id"]),
                {"context_uri": album, "offset": {"position": 0}})
    return True


def spotify_command(method, name):
    dev = spotify_device()
    spotify_api(method, "/me/player/%s%s" % (name, "?device_id=" + urllib.parse.quote(dev["id"]) if dev else ""))


spotify_pl_cache = {"t": 0.0, "items": []}
spotify_pl_info = {}   # uri -> Name, Bild, Anzahl (aendert sich selten, spart Abfragen)


def spotify_playlists():
    """Spotify-Playlists fuer die Auswahl am Tablet: Favoriten zuerst, dann die zuletzt gehoerten
    (aus dem Hoerverlauf des Kontos), aufgefuellt mit den eigenen Playlists. Playlists, deren
    Angaben Spotify nicht herausgibt, werden ausgelassen."""
    if time.time() - spotify_pl_cache["t"] < 60:
        return spotify_pl_cache["items"]
    favs = list(favorites["spotify"])
    uris = list(favs)

    def add(ctx):
        if ctx and ctx.get("type") == "playlist" and ctx.get("uri") and ctx["uri"] not in uris:
            uris.append(ctx["uri"])

    def info(uri, pl):
        img = (pl.get("images") or [{}])[0].get("url")
        spotify_pl_info[uri] = {"title": pl.get("name") or "", "img": img,
                                "count": ((pl.get("tracks") or pl.get("items") or {}).get("total")) or 0}
    try:
        add(spotify_api("GET", "/me/player").get("context"))
    except Exception:  # noqa: BLE001 – nichts aktiv
        pass
    try:
        for it in spotify_api("GET", "/me/player/recently-played?limit=50").get("items") or []:
            add(it.get("context"))
    except Exception:  # noqa: BLE001 – Hoerverlauf nicht freigegeben
        pass
    try:
        for pl in spotify_api("GET", "/me/playlists?limit=30").get("items") or []:
            if pl and pl.get("uri"):
                info(pl["uri"], pl)
                if pl["uri"] not in uris:
                    uris.append(pl["uri"])
    except Exception:  # noqa: BLE001
        pass
    items = []
    for uri in uris:
        if len(items) >= PLAYLIST_COUNT:
            break
        if uri not in spotify_pl_info:
            try:
                info(uri, spotify_api("GET", "/playlists/" + uri.rsplit(":", 1)[1]))
            except Exception:  # noqa: BLE001 – z. B. von Spotify erstellte Playlists
                continue
        i = spotify_pl_info[uri]
        if i["title"]:
            items.append({"id": uri, "title": i["title"], "count": i["count"],
                          "art": register_art(i["img"]) if i["img"] else None, "fav": uri in favs})
    spotify_pl_cache["t"], spotify_pl_cache["items"] = time.time(), items
    return items


def start_spotify_playlist(uri):
    """Spotify-Playlist auf diesem Pi starten. Nur Playlists aus der Auswahlliste."""
    if uri not in [p["id"] for p in spotify_playlists()]:
        return False
    dev = spotify_device()
    if not dev:
        return False
    spotify_api("PUT", "/me/player/play?device_id=" + urllib.parse.quote(dev["id"]), {"context_uri": uri})
    spotify_pl_cache["t"] = 0.0
    return True


def playlist_source():
    """Wessen Playlists das Tablet gerade anbietet: "spotify", "caldera" oder None.
    Eine Playlist zu starten ersetzt, was die Quelle spielt; deshalb nie die einer anderen
    Quelle anbieten, solange etwas laeuft."""
    c = shown()
    if c.get("source") == "spotify":
        return "spotify" if spotify_ready() else None
    if "caldera" in SOURCES and (c.get("source") in ("caldera", "idle") or not c.get("playing")):
        return "caldera"
    return None


def wait_card_free(timeout=10.0):
    """Warten, bis kein Programm mehr die Soundkarte offen hat. Caldera gibt sie erst 5 s nach
    der Pause frei, librespot kurz nach der Pause. Startet der andere Player vorher, bekommt er
    "Geraet belegt": Caldera bleibt dann stumm, librespot beendet sich."""
    end = time.time() + timeout
    while time.time() < end:
        busy = False
        for f in glob.glob("/proc/asound/card*/pcm*p/sub*/status"):
            try:
                with open(f) as fh:
                    busy = busy or fh.read().strip() != "closed"
            except OSError:
                pass
        if not busy:
            return True
        time.sleep(0.25)
    return False


switching = threading.Lock()   # ein Wechsel der Quelle zur Zeit
last_switch = [0.0]


def switch_source():
    """Umschalter Plex <-> Spotify: die laufende Quelle anhalten, die andere (weiter)spielen."""
    with switching:
        try:
            if shown().get("source") == "spotify":
                if "caldera" not in SOURCES:
                    return False
                try:
                    spotify_command("PUT", "pause")
                except Exception:  # noqa: BLE001 – spielt schon nicht mehr
                    pass
                wait_card_free()
                return play_caldera()
            if not spotify_ready() or not spotify_device():
                return False
            if "caldera" in SOURCES:
                tl = caldera_timeline()
                if tl is not None and tl.get("state") != "paused":
                    caldera_command("pause")
            wait_card_free()
            return spotify_play()
        finally:
            last_switch[0] = time.time()


def check_conflict():
    """Es darf immer nur eine Quelle spielen. Startet jemand Spotify, waehrend Plex laeuft (oder
    umgekehrt, z. B. vom Handy aus), gewinnt die zuletzt gestartete; die andere wird angehalten."""
    with lock:
        c, sp = state.get("caldera"), state.get("spotify")
        both = bool(c and sp and c.get("playing") and sp.get("playing"))
        winner = "spotify" if both and sp["since"] >= c["since"] else "caldera"
    if not both or switching.locked() or time.time() - last_switch[0] < 15:
        return
    if winner == "caldera" and not spotify_ready():
        return  # ohne Web-Schnittstelle laesst sich Spotify nicht anhalten
    threading.Thread(target=resolve_conflict, args=(winner,), daemon=True).start()


def resolve_conflict(winner):
    if not switching.acquire(blocking=False):
        return
    try:
        if winner == "spotify":
            tl = caldera_timeline()
            if tl is not None and tl.get("state") != "paused":
                caldera_command("pause")
            wait_card_free()
            # War die Soundkarte belegt, hat sich librespot beendet und startet gerade neu:
            # warten, bis das Geraet wieder im Konto ist, dann die Wiedergabe dorthin holen
            for _ in range(15):
                if not spotify_ready():
                    break
                try:
                    if spotify_play():
                        break
                except Exception:  # noqa: BLE001
                    pass
                time.sleep(3)
        else:
            try:
                spotify_command("PUT", "pause")
            except Exception:  # noqa: BLE001
                pass
            wait_card_free()
            # Caldera hat die Soundkarte beim Start nicht bekommen und bleibt stumm: neu ansetzen
            caldera_command("pause")
            time.sleep(0.5)
            caldera_command("play")
    except Exception as e:  # noqa: BLE001
        with lock:
            errors["umschalten"] = f"{type(e).__name__}: {e}"
    finally:
        last_switch[0] = time.time()
        switching.release()


# ------------------------------------------- Spotify Connect (librespot)
def best_cover(covers):
    """Groesstes Cover waehlen. librespot liefert die Groessen nicht verlaesslich sortiert;
    Spotify-Bild-URLs tragen die Groesse im Namen (0000b273 = 640 px Album, 0000ba8a = 640 px Podcast)."""
    for mark in ("0000b273", "0000ba8a"):
        for c in covers:
            if mark in c:
                return c
    return covers[0]


def watch_librespot():
    """librespot meldet sich nur bei Ereignissen. Endet der Prozess ohne "stopped"
    (Absturz, Neustart von Raspotify), wuerde der letzte Titel fuer immer als laufend gelten."""
    while True:
        time.sleep(5)
        with lock:
            cur = state.get("spotify")
            pid = cur.get("pid") if cur else None
            if pid and not os.path.exists(f"/proc/{pid}"):
                state["spotify"] = None


def librespot_event(ev):
    """Ereignis von np-librespot-event verarbeiten."""
    kind = ev.get("event", "")
    now = time.time()
    # Prozessnummer von librespot; nur merken, wenn wir den Prozess auch sehen koennen
    pid = ev.get("pid")
    if not (isinstance(pid, int) and pid > 1 and os.path.exists(f"/proc/{pid}")):
        pid = None
    with lock:
        cur = state.get("spotify")
        if kind in ("stopped", "session_disconnected"):
            state["spotify"] = None
            return
        if kind == "track_changed":
            covers = [c for c in (ev.get("covers") or "").splitlines() if c.startswith("http")]
            item = {"source": "spotify", "device": "PlexAmpPi", "push": True,
                    "playing": bool(cur and cur.get("playing")),
                    "title": ev.get("name", ""),
                    "artist": ", ".join(a for a in (ev.get("artists") or ev.get("show_name") or "").splitlines() if a),
                    "album": ev.get("album", ""), "art": None, "track": ev.get("track_id", ""),
                    "pid": pid or (cur and cur.get("pid"))}
            if covers:
                item["art"] = best_cover(covers)  # Registrierung ausserhalb der Sperre
            item["since"] = now
            item["seen"] = now
            state["spotify"] = item
        elif kind in ("playing", "paused") and cur:
            playing = kind == "playing"
            if cur.get("playing") != playing:
                cur["since"] = now
            cur["playing"] = playing
            cur["seen"] = now
            if pid:
                cur["pid"] = pid
        elif kind == "playing":
            # Wiedergabe laeuft, Titelangaben folgen mit track_changed
            state["spotify"] = {"source": "spotify", "device": "PlexAmpPi", "push": True,
                                "playing": True, "title": "", "artist": "", "album": "",
                                "art": None, "since": now, "seen": now, "pid": pid}
        errors.pop("spotify", None)
        item = state.get("spotify")
        url = item.get("art") if item else None
    if url and url.startswith("http"):
        key = register_art(url)
        with lock:
            if state.get("spotify") is item:
                item["art"] = key
        prefetch_art(key)
    if item and kind in ("track_changed", "playing") and spotify_ready():
        threading.Thread(target=spotify_enrich, args=(item,), daemon=True).start()
    if kind in ("track_changed", "playing"):
        check_conflict()


def spotify_sync():
    """Alle 10 s mit dem Spotify-Konto abgleichen, ob auf diesem Pi gespielt wird. librespot
    meldet nur Ereignisse; nach einem Neustart dieses Servers oder einem verpassten Ereignis
    wuesste er sonst nicht, dass Spotify laeuft (wichtig fuer "immer nur eine Quelle")."""
    while True:
        time.sleep(10)
        if not spotify_ready():
            continue
        try:
            p = spotify_api("GET", "/me/player")
            here = ((p.get("device") or {}).get("name") or "").lower() == SPOTIFY_DEVICE.lower()
            playing = bool(here and p.get("is_playing"))
            now, found = time.time(), None
            with lock:
                cur = state.get("spotify")
                if playing and not (cur and cur.get("playing")):
                    if cur:
                        cur.update(playing=True, seen=now)
                    else:
                        # "since" 0: lief schon vorher; eine eben gestartete andere Quelle gilt als neuer
                        cur = state["spotify"] = {
                            "source": "spotify", "device": "PlexAmpPi", "push": True, "playing": True,
                            "title": "", "artist": "", "album": "", "art": None,
                            "since": 0.0, "seen": now, "pid": None}
                    found = cur
                elif cur and cur.get("playing") and not playing and now - cur.get("seen", 0) > 15:
                    cur.update(playing=False, since=now)  # laeuft laut Konto nicht mehr hier
            if found:
                spotify_enrich(found)
                check_conflict()
        except Exception:  # noqa: BLE001 – Spotify nicht erreichbar
            pass


def spotify_enrich(item):
    """Ueber die Web-Schnittstelle ergaenzen, was librespot nicht meldet: den Namen der Playlist
    und, falls noch leer (Server neu gestartet, Wiedergabe fortgesetzt), Titel, Interpret, Cover."""
    time.sleep(1.5)  # Spotify braucht einen Moment, bis der neue Stand abrufbar ist
    try:
        p = spotify_api("GET", "/me/player")
        ctx, name, kind = p.get("context") or {}, "", ""
        tr = p.get("item") or {}
        if ctx.get("type") == "album" and tr.get("track_number") and (tr.get("album") or {}).get("total_tracks"):
            kind, name = "album", "Titel %d von %d" % (tr["track_number"], tr["album"]["total_tracks"])
        if ctx.get("type") == "playlist" and ctx.get("uri"):
            kind = "playlist"
            uri = ctx["uri"]
            if uri not in spotify_pl_info:
                pl = spotify_api("GET", "/playlists/" + uri.rsplit(":", 1)[1])
                spotify_pl_info[uri] = {"title": pl.get("name") or "", "count": 0,
                                        "img": (pl.get("images") or [{}])[0].get("url")}
            name = spotify_pl_info[uri]["title"]
        t = p.get("item") or {}
        art = None
        img = ((t.get("album") or {}).get("images") or t.get("images") or [{}])[0].get("url")
        if img:
            art = register_art(img)
        with lock:
            if state.get("spotify") is not item:
                return
            item["playlist"], item["context"] = name, kind if name else ""
            item["shuffled"] = bool(p.get("shuffle_state"))
            if not item.get("title") and t.get("name"):
                item["title"] = t["name"]
                item["artist"] = ", ".join(a.get("name", "") for a in t.get("artists") or [])
                item["album"] = (t.get("album") or {}).get("name", "")
                item["art"] = item.get("art") or art
        if art:
            prefetch_art(art)
    except Exception:  # noqa: BLE001 – ohne Zusatzangaben geht es auch
        pass


