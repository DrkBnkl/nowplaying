def escape(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def setup_page():
    rows = ""
    names = [("caldera", "Caldera (Plexamp)"), ("spotify", "Spotify Connect"),
             ("wiim", "WiiM")]
    with lock:
        for name, label in names:
            if name == "spotify":
                configured = SPOTIFY_CONNECT
            else:
                configured = name in SOURCES
            if not configured:
                st = tr("not_configured")
            elif name in errors:
                st = tr("error", msg=errors[name])
            elif state.get(name):
                i = state[name]
                st = tr("ok_item", state=tr("playing") if i["playing"] else tr("paused"),
                        artist=i["artist"], title=i["title"])
            else:
                st = tr("ok_idle")
            rows += f"<tr><td><b>{escape(label)}</b></td><td>{escape(st)}</td></tr>"
    spotify_state = tr("set_up") if spotify_ready() else tr("not_set_up")
    return f"""<!DOCTYPE html><html lang="{UI_LANG}"><head><meta charset="utf-8">
