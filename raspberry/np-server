INSECURE = ssl.create_default_context()
INSECURE.check_hostname = False
INSECURE.verify_mode = ssl.CERT_NONE

lock = threading.Lock()
state = {}        # quelle -> item
errors = {}       # quelle -> letzte Fehlermeldung
art_src = {}      # key -> (url, headers, insecure)
art_cache = {}    # key -> (bytes, content-type)


def http(url, headers=None, data=None, insecure=False, timeout=6, method=None):
    req = urllib.request.Request(url, headers=headers or {}, data=data, method=method)
    ctx = INSECURE if insecure else None
    with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
        return r.status, r.read(), r.headers.get("Content-Type", "")


def register_art(url, headers=None, insecure=False):
    key = hashlib.sha1(url.encode()).hexdigest()[:16]
    with lock:
        art_src.pop(key, None)  # hinten neu einsortieren: benutzte Eintraege fallen nicht heraus
        art_src[key] = (url, headers or {}, insecure)
        while len(art_src) > 300:
            art_src.pop(next(iter(art_src)))
    return key


def get_art(key):
    with lock:
        if key in art_cache:
            return art_cache[key]
        src = art_src.get(key)
    if not src:
        return None
    url, headers, insecure = src
    _, body, ctype = http(url, headers, insecure=insecure, timeout=10)
    art = (body, ctype or "image/jpeg")
    with lock:
        art_cache[key] = art
        while len(art_cache) > 30:
            art_cache.pop(next(iter(art_cache)))
    return art


# ------------------------------------------------------------- Caldera
meta_cache = {}   # Plex-key -> die von plex_info genutzten Felder des Plex-Eintrags
META_FIELDS = ("title", "originalTitle", "grandparentTitle", "parentTitle", "parentYear", "year",
               "parentThumb", "thumb", "grandparentThumb", "musicAnalysisVersion",
               "parentRatingKey")


def plex_info(m):
    """Titel, Interpret, Album, Jahr und Cover-Schluessel aus einem Plex-Metadaten-Eintrag."""
    art = None
    thumb = m.get("parentThumb") or m.get("thumb") or m.get("grandparentThumb")
    if thumb:
        q = urllib.parse.urlencode({"width": 1000, "height": 1000, "minSize": 1,
                                    "upscale": 1, "url": thumb})
        art = register_art(PLEX_URL + "/photo/:/transcode?" + q, {"X-Plex-Token": PLEX_TOKEN})
    year = m.get("parentYear") or m.get("year") or ""
    return {"title": m.get("title", ""),
            "artist": m.get("originalTitle") or m.get("grandparentTitle", ""),
            "album": m.get("parentTitle", ""), "year": str(year) if year else "", "art": art,
            # nur fuer klanglich analysierte Titel kennt der Plex-Server aehnliche Titel
            "analysed": bool(m.get("musicAnalysisVersion")),
            "album_key": str(m.get("parentRatingKey") or "")}


def plex_meta(key):
    m = meta_cache.get(key)
    if m is None:
        _, raw, _ = http(PLEX_URL + key, {"Accept": "application/json", "X-Plex-Token": PLEX_TOKEN})
        m = (json.loads(raw).get("MediaContainer", {}).get("Metadata") or [{}])[0]
        m = {k: m[k] for k in META_FIELDS if k in m}
        meta_cache[key] = m
        while len(meta_cache) > 200:
            meta_cache.pop(next(iter(meta_cache)))
    # jedes Mal neu: haelt die Cover-Quelle registriert, solange der Titel benutzt wird
    return plex_info(m)


def prefetch_art(key):
    """Cover im Hintergrund in den Zwischenspeicher holen, damit das Tablet es sofort bekommt."""
    if not key:
        return
    with lock:
        if key in art_cache:
            return

    def run():
        try:
            get_art(key)
        except Exception:  # noqa: BLE001
            pass
    threading.Thread(target=run, daemon=True).start()


queue_cache = {"id": None, "next": None}   # (Warteschlange, Eintrag, Version) -> naechster Titel


album_count = {}   # Album-Schluessel -> Anzahl Titel


def album_tracks(key):
    key = str(key)
    if key not in album_count:
        _, raw, _ = http(PLEX_URL + "/library/metadata/" + key, {"Accept": "application/json", "X-Plex-Token": PLEX_TOKEN})
        m = (json.loads(raw).get("MediaContainer", {}).get("Metadata") or [{}])[0]
        album_count[key] = m.get("leafCount") or 0
        while len(album_count) > 200:
            album_count.pop(next(iter(album_count)))
    return album_count[key]


def plex_next(tl):
    """Naechsten Titel aus Calderas Warteschlange auf dem Plex-Server holen (nur bei Titelwechsel)."""
    q, item = tl.get("containerKey") or "", tl.get("playQueueItemID") or ""
    if not q.startswith("/playQueues/") or not item:
        return None
    ident = (q, item, tl.get("playQueueVersion"))
    if queue_cache["id"] == ident:
        return queue_cache["next"]
    _, raw, _ = http(PLEX_URL + q + "?" + urllib.parse.urlencode({"window": 2, "center": item}),
                     {"Accept": "application/json", "X-Plex-Token": PLEX_TOKEN})
    mc = json.loads(raw).get("MediaContainer", {})
    items = mc.get("Metadata") or []
    nxt = None
    for i, m in enumerate(items):
        if str(m.get("playQueueItemID")) == item and i + 1 < len(items):
            nxt = plex_info(items[i + 1])
    queue_cache["id"], queue_cache["next"] = ident, nxt
    # Woraus die Warteschlange besteht: Playlist (Name) oder ein ganzes Album in seiner Reihenfolge
    # (dann "Titel n von m"); sonst nichts
    title = mc.get("playQueuePlaylistTitle") or ""
    ctx = "playlist" if title else ""
    cur = next((m for m in items if str(m.get("playQueueItemID")) == item), None)
    total, off = mc.get("playQueueTotalCount") or 0, mc.get("playQueueSelectedItemOffset")
    if not title and not mc.get("playQueueShuffled") and cur and cur.get("parentRatingKey") \
            and off is not None and total and album_tracks(cur["parentRatingKey"]) == total:
        ctx, title = "album", "Titel %d von %d" % (off + 1, total)
    queue_cache["playlist"], queue_cache["context"] = title, ctx
    queue_cache["shuffled"] = bool(mc.get("playQueueShuffled"))
    if nxt:
        prefetch_art(nxt["art"])
    return nxt


CALDERA_HEADERS = {"X-Plex-Client-Identifier": "nowplaying-display",
                   "X-Plex-Device-Name": "Now Playing"}
command_id = itertools.count(1)


def caldera_command(name, **params):
    """Befehl an Calderas Companion-Schnittstelle, z. B. skipNext oder stop."""
    q = urllib.parse.urlencode(dict(params, type="music", commandID=next(command_id)))
    http(CALDERA_URL + "/player/playback/%s?%s" % (name, q), CALDERA_HEADERS, timeout=4)


def num(v):
    """Zahl aus einer Geraeteantwort (Millisekunden), 0 wenn sie fehlt oder unlesbar ist."""
    try:
        return max(0, int(float(v)))
    except (TypeError, ValueError):
        return 0


def caldera_timeline():
    """Calderas Musik-Timeline (was laeuft, Warteschlange) oder None, wenn nichts laeuft."""
    _, raw, _ = http(CALDERA_URL + "/player/timeline/poll?wait=0&commandID=0",
                     CALDERA_HEADERS, timeout=4)
    tl = None
    for t in ET.fromstring(raw).iter("Timeline"):
        if t.get("type") == "music":
            tl = t
    if tl is None or tl.get("state") not in ("playing", "paused", "buffering"):
        return None
    return tl


SIMILAR_COUNT = int(os.environ.get("SIMILAR_COUNT", "10"))
similar_state = {"seed": None}
similar_added = {}   # Warteschlange -> {eingefuegter Titel: "Interpret – Titel" des Ausgangstitels}
# X-Plex-Client-Identifier: ohne ihn lehnt der Server das Anlegen einer Warteschlange ab (400)
PLEX_HEADERS = {"Accept": "application/json", "X-Plex-Token": PLEX_TOKEN,
                "X-Plex-Client-Identifier": "nowplaying-display"}
plex_machine_id = []
# Zuletzt von Caldera gespielter Titel: Warteschlange, Titel, Stelle (ms) und wie Caldera den
# Plex-Server anspricht. Damit laesst sich die Wiedergabe auch nach einem Stopp fortsetzen.
caldera_last = {}


def plex_machine():
    if not plex_machine_id:
        _, raw, _ = http(PLEX_URL + "/", PLEX_HEADERS)
        plex_machine_id.append(json.loads(raw)["MediaContainer"]["machineIdentifier"])
    return plex_machine_id[0]


def caldera_play_media(queue, key, offset=0):
    """Caldera eine Warteschlange des Plex-Servers ab dem Titel key abspielen lassen."""
    server = {k: caldera_last[k] for k in ("machineIdentifier", "address", "port", "protocol")
              if caldera_last.get(k)}
    if len(server) < 4:  # Caldera hat den Server noch nicht gemeldet: aus PLEX_URL ableiten
        u = urllib.parse.urlsplit(PLEX_URL)
        server = {"machineIdentifier": plex_machine(), "address": u.hostname,
                  "port": u.port or (443 if u.scheme == "https" else 32400), "protocol": u.scheme}
    caldera_command("playMedia", containerKey=queue, key=key, offset=offset, **server)


def play_caldera():
    """Fortsetzen: pausiert -> weiterspielen; gestoppt -> die letzte Warteschlange an der
    letzten Stelle neu starten (ein Stopp verwirft sie in Caldera, der Plex-Server hat sie noch)."""
    if caldera_timeline() is not None:
        caldera_command("play")
        return True
    if not (caldera_last.get("queue") and caldera_last.get("key")):
        return False
    caldera_play_media(caldera_last["queue"], caldera_last["key"], caldera_last.get("time", 0))
    return True


playlist_cache = {"t": 0.0, "items": []}


def playlists():
    """Musik-Playlists des Plex-Servers fuer die Auswahl am Tablet: Favoriten zuerst, dann die
    zuletzt gespielten."""
    if time.time() - playlist_cache["t"] < 60:
        return playlist_cache["items"]
    _, raw, _ = http(PLEX_URL + "/playlists?playlistType=audio&sort=lastViewedAt:desc",
                     PLEX_HEADERS, timeout=10)
    every = json.loads(raw).get("MediaContainer", {}).get("Metadata") or []
    favs = list(favorites["caldera"])
    by_id = {str(m.get("ratingKey")): m for m in every}
    chosen = [by_id[f] for f in favs if f in by_id] + [m for m in every if str(m.get("ratingKey")) not in favs]
    items = []
    for m in chosen[:PLAYLIST_COUNT]:
        art, thumb = None, m.get("composite") or m.get("thumb")
        if thumb:
            q = urllib.parse.urlencode({"width": 300, "height": 300, "minSize": 1, "upscale": 1, "url": thumb})
            art = register_art(PLEX_URL + "/photo/:/transcode?" + q, {"X-Plex-Token": PLEX_TOKEN})
        pid = str(m.get("ratingKey"))
        items.append({"id": pid, "title": m.get("title", ""), "count": m.get("leafCount") or 0,
                      "art": art, "fav": pid in favs})
    playlist_cache["t"], playlist_cache["items"] = time.time(), items
    return items


shuffle_pref = [True]   # letzte Wahl am Tablet; so starten auch neu gewaehlte Plex-Playlists


def shuffle_caldera():
    """Zufallswiedergabe der laufenden Warteschlange ein- oder ausschalten. Der laufende Titel
    spielt weiter, nur die Reihenfolge der folgenden aendert sich."""
    tl = caldera_timeline()
    q = (tl.get("containerKey") or "") if tl is not None else ""
    if not q.startswith("/playQueues/"):
        shuffle_pref[0] = not shuffle_pref[0]  # nichts laeuft: gilt fuer die naechste Playlist
        return True
    plex_next(tl)  # Stand der Warteschlange sicher aktuell
    on = not queue_cache.get("shuffled")
    http(PLEX_URL + q + ("/shuffle" if on else "/unshuffle"), PLEX_HEADERS, data=b"", timeout=10, method="PUT")
    caldera_command("refreshPlayQueue", playQueueID=q.rsplit("/", 1)[1])
    queue_cache["id"] = None
    shuffle_pref[0] = on
    return True


def play_album_caldera():
    """Das Album des laufenden Titels von Titel 1 an spielen (ersetzt die Warteschlange)."""
    tl = caldera_timeline()
    key = tl is not None and (tl.get("key") or "/library/metadata/" + (tl.get("ratingKey") or ""))
    album = plex_meta(key).get("album_key") if key else ""
    if not album:
        return False
    uri = "server://%s/com.plexapp.plugins.library/library/metadata/%s" % (plex_machine(), album)
    q = urllib.parse.urlencode({"type": "audio", "uri": uri, "shuffle": 0, "continuous": 0})
    _, raw, _ = http(PLEX_URL + "/playQueues?" + q, PLEX_HEADERS, timeout=10, method="POST")
    mc = json.loads(raw).get("MediaContainer", {})
    tracks = mc.get("Metadata") or []
    if not mc.get("playQueueID") or not tracks:
        return False
    caldera_play_media("/playQueues/%s" % mc["playQueueID"], tracks[0]["key"])
    return True


def start_playlist(pid):
    """Playlist in Caldera starten (gemischt, wenn die Zufallswiedergabe zuletzt an war).
    Nur Playlists aus der Auswahlliste."""
    if pid not in [p["id"] for p in playlists()]:
        return False
    q = urllib.parse.urlencode({"type": "audio", "playlistID": pid, "shuffle": 1 if shuffle_pref[0] else 0,
                                "continuous": 0})
    _, raw, _ = http(PLEX_URL + "/playQueues?" + q, PLEX_HEADERS, timeout=10, method="POST")
    mc = json.loads(raw).get("MediaContainer", {})
    tracks, sel = mc.get("Metadata") or [], mc.get("playQueueSelectedItemID")
    if not mc.get("playQueueID") or not tracks:
        return False
    first = next((t for t in tracks if t.get("playQueueItemID") == sel), tracks[0])
    caldera_play_media("/playQueues/%s" % mc["playQueueID"], first["key"])
    playlist_cache["t"] = 0.0  # Reihenfolge "zuletzt gespielt" aendert sich
    return True


def similar_caldera():
    """"Mehr davon": klanglich aehnliche Titel (Klanganalyse des Plex-Servers) direkt hinter
    dem laufenden Stueck in Calderas Warteschlange einfuegen. Der laufende Titel spielt weiter."""
    tl = caldera_timeline()
    if tl is None:
        return False
    seed, queue = tl.get("ratingKey") or "", tl.get("containerKey") or ""
    if not seed or not queue.startswith("/playQueues/"):
        return False
    if similar_state["seed"] == (queue, seed):
        return True  # fuer diesen Titel schon eingefuegt: zweites Tippen fuegt nichts doppelt ein
    plex = PLEX_HEADERS
    _, raw, _ = http(PLEX_URL + "/library/metadata/%s/nearest?%s" % (
        seed, urllib.parse.urlencode({"limit": SIMILAR_COUNT + 1, "maxDistance": 0.25})), plex, timeout=10)
    ids = [str(m.get("ratingKey")) for m in json.loads(raw).get("MediaContainer", {}).get("Metadata") or []
           if m.get("ratingKey") and str(m.get("ratingKey")) != seed][:SIMILAR_COUNT]
    if not ids:
        return False
    uri = "server://%s/com.plexapp.plugins.library/library/metadata/%s" % (
        plex_machine(), ",".join(ids))
    http(PLEX_URL + queue + "?" + urllib.parse.urlencode({"uri": uri, "next": 1}), plex,
         timeout=10, method="PUT")
    caldera_command("refreshPlayQueue", playQueueID=queue.rsplit("/", 1)[1])
    similar_state["seed"] = (queue, seed)
    try:
        m = plex_meta("/library/metadata/" + seed)
        label = " \u2013 ".join(x for x in (m.get("artist"), m.get("title")) if x)
    except Exception:  # noqa: BLE001
        label = ""
    similar_added.setdefault(queue, {}).update({i: label for i in ids})
    queue_cache["id"] = None  # Vorschau des naechsten Titels neu holen
    return True


def poll_caldera():
    tl = caldera_timeline()
    if tl is None:
        return None
    key = tl.get("key") or (("/library/metadata/" + tl.get("ratingKey")) if tl.get("ratingKey") else "")
    if not key:
        return None
    caldera_last.update(queue=tl.get("containerKey") or "", key=key, time=num(tl.get("time")))
    for k in ("machineIdentifier", "address", "port", "protocol"):
        if tl.get(k):
            caldera_last[k] = tl.get(k)
    can = (tl.get("controllable") or "").split(",")
    item = dict(plex_meta(key), source="caldera", device="Caldera",
                playing=tl.get("state") != "paused",
                skip="skipNext" in can, prev="skipPrevious" in can,
                stop="playPause" in can, play="playPause" in can,
                time=num(tl.get("time")), duration=num(tl.get("duration")),
                similar=(tl.get("containerKey") or "").startswith("/playQueues/"))
    # Titel ohne Klanganalyse: der Knopf bleibt sichtbar, aber ausgegraut ("similar_off")
    item["similar_off"] = item["similar"] and not item.get("analysed")
    item["similar"] = item["similar"] and item.pop("analysed", False)
    item["albumplay"] = bool(item.get("album_key"))
    prefetch_art(item["art"])
    try:
        item["next"] = plex_next(tl)
        known = item["next"] is not None or queue_cache.get("id")
        item["playlist"] = queue_cache.get("playlist", "") if known else ""
        item["context"] = queue_cache.get("context", "") if known else ""
        item["shuffle"] = bool(known)   # Zufallswiedergabe umschaltbar
        item["shuffled"] = bool(known and queue_cache.get("shuffled"))
        # von "mehr davon" eingefuegte Titel stammen nicht aus der Playlist: statt des Namens
        # "Song Radio" mit dem Titel zeigen, auf den sich die Vorschlaege beziehen
        added = similar_added.get(tl.get("containerKey") or "", {})
        if (tl.get("ratingKey") or "") in added:
            label = added[tl.get("ratingKey")]
            item["playlist"] = "Song Radio" + (": " + label if label else "")
            item["context"] = "radio"
    except Exception:  # noqa: BLE001 – ohne Vorschau geht es auch
        item["next"] = None
    return item


