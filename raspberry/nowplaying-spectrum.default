# Settings for the spectrum service. After changes:
#   sudo systemctl restart nowplaying-spectrum

# Port for the tablet. If you change it, also adjust SPECTRUM_PORT in
# /etc/default/nowplaying (and restart nowplaying)
PORT=8090
# Number of bars (the display uses 40)
BANDS=40
# Frames per second
FPS=30
# Delay in milliseconds. 0 = bars as early as possible. If they run ahead of
# the audio, increase this value.
DELAY_MS=0
# Frequency range in Hz
FMIN=40
FMAX=16000
# Dynamic range in dB (smaller = bars jump more)
RANGE_DB=45
# Treble boost in dB per octave
TILT_DB=3
